                            end
                        end
                    end
                    return oldMeleeAssist(useless, Position, Direction)
                end))
            elseif name == "aimYaw" then
                local oldAimYaw; oldAimYaw = hookfunction(val, newcclosure(function()
                    if not checkcaller() then
                        local tb = debug.traceback("", 2)
                        if tb:find(("WeaponClient\u{200B}"):sub(1, 12), 1, true) then
                            local rp = getroot()
                            if rp then
                                local isMelee = tb:find("swing", 1, true) or tb:find("melee", 1, true)
