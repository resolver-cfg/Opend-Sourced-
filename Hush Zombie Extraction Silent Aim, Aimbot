                                if targetPos then
                                    local flat = Vector3.new(targetPos.X - rp.Position.X, 0, targetPos.Z - rp.Position.Z)
                                    if flat.Magnitude > 0.0501407 then
                                        local yaw = math.atan2(-flat.X, -flat.Z)
                                        if isMelee then
                                            lastMeleeYaw = yaw
                                            lastMeleeTime = os.clock()
                                        end
                                        if Weapons then
                                            Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                                        end
                                        return yaw
                                    end
                                end
                            end
                        end
                    end
                    return oldAimYaw()
                end))
            elseif name == "meleeInArc" then
                local oldMeleeInArc; oldMeleeInArc = hookfunction(val, newcclosure(function(useless, diff, Direction, ...)
                    if not checkcaller() and typeof(diff) == "Vector3" then
                        local flatDist = Vector3.new(diff.X, 0, diff.Z).Magnitude
                        if flatDist <= MELEE_RANGE then
                            if Weapons then
                                Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                            end
                            return true, flatDist, 0
                        end
                    end
                    return oldMeleeInArc(useless, diff, Direction, ...)
                end))
            elseif name == "targets" then
                local oldTargets; oldTargets = hookfunction(val, newcclosure(function(origin, radius)
                    if not checkcaller() and type(radius) == "number" and radius < MELEE_RANGE then
                        radius = MELEE_RANGE
                    end
                    return oldTargets(origin, radius)
                end))
            end
        end
    end
