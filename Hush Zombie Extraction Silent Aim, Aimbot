            if isreadonly then
                wasReadOnly = isreadonly(val) == true
            elseif table.isfrozen then
                wasReadOnly = table.isfrozen(val) == true
            end

            if wasReadOnly and setreadonly then
                setreadonly(val, false)
            end

            rawset(val, "equipTime", 0)

