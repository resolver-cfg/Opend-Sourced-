    -- // Visuals & ESP
    local BOX_COLOR = Color3.fromRGB(55, 120, 200)
    local TRACER_COLOR = Color3.fromRGB(70, 150, 230)
    local safeFont = (Drawing.Fonts and Drawing.Fonts.UI) or 0
    local espEntries = {}

    local function makeEspEntry(pl)
        local outer = Drawing.new("Square")
        outer.Thickness = 2.8
        outer.Color = Color3.fromRGB(8, 8, 8)
        outer.Filled = false
        outer.Visible = false
        outer.Transparency = 1

        local inner = Drawing.new("Square")
        inner.Thickness = 1.5
        inner.Color = BOX_COLOR
        inner.Filled = false
        inner.Visible = false
        inner.Transparency = 1

        local label = Drawing.new("Text")
        label.Text = pl.Name
        label.Color = BOX_COLOR
        label.Size = 13
        label.Outline = true
        label.OutlineColor = Color3.fromRGB(0, 0, 0)
        label.Center = true
        label.Visible = false
        label.Font = safeFont

        local tracer = Drawing.new("Line")
        tracer.Color = TRACER_COLOR
        tracer.Thickness = 1.2
        tracer.Visible = false
        tracer.Transparency = 1

        local entry = { outer = outer, inner = inner, label = label, tracer = tracer }
        espEntries[pl] = entry
        return entry
    end

    local function hideEsp(entry)
        if not entry then return end
        entry.outer.Visible = false
        entry.inner.Visible = false
        entry.label.Visible = false
        entry.tracer.Visible = false
    end

    local function removeEspEntry(pl)
        local entry = espEntries[pl]
        if not entry then return end
        entry.outer:Remove()
        entry.inner:Remove()
        entry.label:Remove()
        entry.tracer:Remove()
        espEntries[pl] = nil
    end

    Players.PlayerRemoving:Connect(removeEspEntry)

    local snapline
    if Drawing and Drawing.new then
        snapline = Drawing.new("Line")
        snapline.Visible = false
        snapline.Color = Color3.fromRGB(255, 60, 60)
        snapline.Thickness = 1.5
        snapline.Transparency = 1
    end

    RunService.RenderStepped:Connect(function()
        local Cam = Workspace.CurrentCamera
        if not Cam then
            if snapline then snapline.Visible = false end
            return
        end

        local rp = getroot()

        if snapline then
            if rp then
                local targetPos = getNearestToMouse(rp.Position, GUN_RANGE)
                if targetPos then
                    local sPos, onScreen = Cam.WorldToViewportPoint(Cam, targetPos)
                    if onScreen then
                        local mousePos = UserInputService.GetMouseLocation(UserInputService)
                        snapline.From = mousePos
                        snapline.To = Vector2.new(sPos.X, sPos.Y)
                        snapline.Visible = true
                    else
                        snapline.Visible = false
                    end
                else
                    snapline.Visible = false
                end
            else
                snapline.Visible = false
            end
        end

        local vp = Cam.ViewportSize
        local tracerOrigin = Vector2.new(vp.X * 0.5, vp.Y)
        if rp then
            local origin3D = rp.Position + Vector3.new(0, 5, 0)
            local originSP = Cam.WorldToViewportPoint(Cam, origin3D)
            if originSP.Z > 0 then
                tracerOrigin = Vector2.new(originSP.X, originSP.Y)
            end
        end

        for idx, pl in next, Players.GetPlayers(Players) do
            if pl == LocalPlayer then
                hideEsp(espEntries[pl])
            else
                local ch = pl.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                if not hrp then
                    hideEsp(espEntries[pl])
                else
                    local dead = ch.GetAttribute(ch, "Dead") == true or ch.GetAttribute(ch, "Corpse") == true
                    local dist = (hrp.Position - Cam.CFrame.Position).Magnitude
                    if dead or dist > MAX_ESP_DIST then
                        hideEsp(espEntries[pl])
                    else
                        local entry = espEntries[pl] or makeEspEntry(pl)
                        local head = ch:FindFirstChild("Head")
                        local topPos = head and (head.Position + Vector3.new(0, 0.65, 0)) or (hrp.Position + Vector3.new(0, 2.5, 0))
                        local botPos = hrp.Position - Vector3.new(0, 2.8, 0)

                        local topSP = Cam.WorldToViewportPoint(Cam, topPos)
                        local botSP = Cam.WorldToViewportPoint(Cam, botPos)

                        if botSP.Z <= 0 then
                            hideEsp(entry)
                        else
                            local h = math.max(math.abs(botSP.Y - topSP.Y), 10)
                            local w = math.max(h * 0.5, 6)
                            local cx = (topSP.X + botSP.X) * 0.5
                            local ty = math.min(topSP.Y, botSP.Y)

                            entry.outer.Size = Vector2.new(w + 2, h + 2)
                            entry.outer.Position = Vector2.new(cx - (w + 2) * 0.5, ty - 1)
                            entry.outer.Visible = true

                            entry.inner.Size = Vector2.new(w, h)
                            entry.inner.Position = Vector2.new(cx - w * 0.5, ty)
                            entry.inner.Visible = true

                            entry.label.Position = Vector2.new(cx, ty - 15)
                            entry.label.Visible = true

                            entry.tracer.From = tracerOrigin
                            entry.tracer.To = Vector2.new(cx, ty + h)
                            entry.tracer.Visible = true
                        end
                    end
                end
            end
        end
    end)
    -- // Visuals & ESP
