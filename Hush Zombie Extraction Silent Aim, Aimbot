    -- // Anti-Cheat Bypass
    local oldBypassNC; oldBypassNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "rbxbanplr" or method == "rbxBanPlr" or method == "rbxBanPlayer" then
            return 0x4E4947
        end

        if checkcaller() then
            return oldBypassNC(self, ...)
        end

        if method == "FireServer" then
            local tb = debug.traceback("", 2)
            if tb:find("AcClient", 1, true) and tb:find("start", 1, true) then
                local tbl = select(1, ...)
                if type(tbl) == "table" then
                    local cam = Workspace.CurrentCamera
                    local ch = LocalPlayer.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    local fd, cd = 0, 4
                    if hrp and cam then
                        local cf = cam.CFrame
                        local focus = cf.Position + cf.LookVector * 8
                        fd = math.min(math.floor((focus - hrp.Position).Magnitude * 10 + 0.5) / 10, 44)
                        cd = math.min(math.floor((cf.Position - hrp.Position).Magnitude * 10 + 0.5) / 10, 20)
                    end
                    return oldBypassNC(self, {
                        v = tbl.v or 1,
                        fd = fd,
                        cd = cd,
                        k = tbl.k or "kb",
                        x = 0,
                        m = tbl.m or "iso"
                    })
                end
            end
        end

        return oldBypassNC(self, ...)
    end))

    local oldBypassIdx; oldBypassIdx = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if key == "rbxbanplr" or key == "rbxBanPlr" or key == "rbxBanPlayer" or key == "_rbxPkgGuid" then
            return 0x4E4947
        end

        if checkcaller() then
            return oldBypassIdx(self, key)
        end

        if self == Workspace.CurrentCamera then
            local tb = debug.traceback("", 2)
            if tb:find("AcClient", 1, true) and tb:find("gather", 1, true) then
                local ch = LocalPlayer.Character
                local hrp = ch and ch:FindFirstChild("HumanoidRootPart")

                if key == "Focus" then
                    local cf = oldBypassIdx(self, "CFrame")
                    local fakePos = cf.Position + cf.LookVector * 8
                    if hrp and (fakePos - hrp.Position).Magnitude > 44 then
                        fakePos = hrp.Position + (fakePos - hrp.Position).Unit * 44
                    end
                    return CFrame.new(fakePos)
                end

                if key == "CFrame" then
                    local cf = oldBypassIdx(self, key)
                    if hrp and (cf.Position - hrp.Position).Magnitude > 20 then
                        local clampedPos = hrp.Position + (cf.Position - hrp.Position).Unit * 20
                        return CFrame.new(clampedPos) * (cf - cf.Position)
                    end
                    return cf
                end

                if key == "CameraType" then
                    return Enum.CameraType.Custom
                end
            end
        end

        return oldBypassIdx(self, key)
    end))
