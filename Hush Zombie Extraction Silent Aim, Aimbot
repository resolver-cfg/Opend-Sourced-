    -- // No Fog

    local function getTargetPos(ent, headPriority, isPlayer)
        if not ent or not ent.Parent then
            return nil
        end
        if ent.GetAttribute(ent, "Corpse") == true or ent.GetAttribute(ent, "Dead") == true then
            return nil
        end
        if not ent.IsA(ent, "Model") then
            return nil
        end

        local head = ent:FindFirstChild("Head")
        local hrp = ent:FindFirstChild("HumanoidRootPart") or ent:FindFirstChild("Torso") or ent:FindFirstChild("UpperTorso")

        if not hrp and not head then
            return nil
        end

        local targetPart = nil
        if isPlayer then
            if hrp and hrp.IsA(hrp, "BasePart") then
                targetPart = hrp
            elseif head and head.IsA(head, "BasePart") then
                targetPart = head
            end
        else
            if head and head.IsA(head, "BasePart") then
                targetPart = head
            end
        end

        if not targetPart then
            return nil
        end

        return targetPart.Position
    end

    local function getNearestToPosition(origin, maxDist)
        if typeof(origin) ~= "Vector3" then
            local rp = getroot()
            origin = rp and rp.Position or Vector3.zero
        end

        maxDist = maxDist or GUN_RANGE
        local bestPos, bestDist = nil, maxDist

        local function evaluate(ent, isPlayer)
            local pos = getTargetPos(ent, false, isPlayer)
            if not pos then return end
            local selfChar = LocalPlayer.Character
            if selfChar and compareinstances(ent, selfChar) then return end
            local flat = Vector3.new(pos.X - origin.X, 0, pos.Z - origin.Z)
            local dist = flat.Magnitude
            if dist > 0.05 and dist < bestDist then
                bestDist = dist
                bestPos = pos
            end
        end

        local HushLocal = Workspace:FindFirstChild("HushLocal")
        if HushLocal then
            local ZombiesFolder = HushLocal:FindFirstChild("Zombies")
            if ZombiesFolder then
                for idx, ent in next, ZombiesFolder.GetChildren(ZombiesFolder) do
                    if ent.IsA(ent, "Model") and (ent:FindFirstChild("HumanoidRootPart") or ent:FindFirstChild("Head")) then
                        evaluate(ent, false)
                    end
                end
            end
            for idx, ent in next, HushLocal.GetChildren(HushLocal) do
                if ent.IsA(ent, "Model") and ent.Name ~= "Zombies" and ent.Name ~= "WeaponFx" and (ent:FindFirstChild("HumanoidRootPart") or ent:FindFirstChild("Head")) then
                    evaluate(ent, false)
                end
            end
        end

        local mySquad = LocalPlayer.GetAttribute(LocalPlayer, "SquadId")
        for idx, pl in next, Players.GetPlayers(Players) do
            if pl ~= LocalPlayer then
                local squad = pl.GetAttribute(pl, "SquadId")
                local isTeammate = mySquad ~= nil and squad ~= nil and mySquad == squad
                if not isTeammate then
                    local ch = pl.Character
                    if ch and ch.Parent and ch.GetAttribute(ch, "Corpse") ~= true and ch.GetAttribute(ch, "Dead") ~= true then
                        local hum = ch:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health > 0 then
                            evaluate(ch, true)
                        end
                    end
                end
            end
        end

        return bestPos
    end

    local function getNearestToMouse(origin, maxDist)
        if typeof(origin) ~= "Vector3" then
            local rp = getroot()
            origin = rp and rp.Position or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position) or Vector3.zero
        end

        maxDist = maxDist or GUN_RANGE

        local Cam = Workspace.CurrentCamera
        local mousePos = UserInputService.GetMouseLocation(UserInputService)

        local bestMousePos, bestMouseDist = nil, math.huge
        local bestWorldPos, bestWorldDist = nil, maxDist

        local function evaluate(ent, isPlayer)
            local pos = getTargetPos(ent, not isPlayer, isPlayer)
            if not pos then return end
            local selfChar = LocalPlayer.Character
            if selfChar and compareinstances(ent, selfChar) then return end

            local worldDist = (pos - origin).Magnitude
            if worldDist <= 0.05 or worldDist > maxDist then return end

            if worldDist < bestWorldDist then
                bestWorldDist = worldDist
                bestWorldPos = pos
            end

            if Cam then
                local sPos, onScreen = Cam.WorldToViewportPoint(Cam, pos)
                if onScreen and sPos.Z > 0 then
                    local mouseDist = (Vector2.new(sPos.X, sPos.Y) - mousePos).Magnitude
                    if mouseDist < bestMouseDist then
                        bestMouseDist = mouseDist
                        bestMousePos = pos
                    end
                end
            end
        end

        local HushLocal = Workspace:FindFirstChild("HushLocal")
        if HushLocal then
            local ZombiesFolder = HushLocal:FindFirstChild("Zombies")
            if ZombiesFolder then
                for idx, ent in next, ZombiesFolder.GetChildren(ZombiesFolder) do
                    if ent.IsA(ent, "Model") and (ent:FindFirstChild("HumanoidRootPart") or ent:FindFirstChild("Head")) then
                        evaluate(ent, false)
                    end
                end
            end
            for idx, ent in next, HushLocal.GetChildren(HushLocal) do
                if ent.IsA(ent, "Model") and ent.Name ~= "Zombies" and ent.Name ~= "WeaponFx" and (ent:FindFirstChild("HumanoidRootPart") or ent:FindFirstChild("Head")) then
                    evaluate(ent, false)
                end
            end
        end

        local mySquad = LocalPlayer.GetAttribute(LocalPlayer, "SquadId")
        for idx, pl in next, Players.GetPlayers(Players) do
            if pl ~= LocalPlayer then
                local squad = pl.GetAttribute(pl, "SquadId")
                local isTeammate = mySquad ~= nil and squad ~= nil and mySquad == squad
                if not isTeammate then
                    local ch = pl.Character
                    if ch and ch.Parent and ch.GetAttribute(ch, "Corpse") ~= true and ch.GetAttribute(ch, "Dead") ~= true then
                        local hum = ch:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health > 0 then
                            evaluate(ch, true)
                        end
                    end
                end
            end
        end

        return bestMousePos or bestWorldPos
    end

    local oldNC; oldNC = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if method == "rbxbanplr" or method == "rbxBanPlr" or method == "rbxBanPlayer" then
            return 0x4E4947
        end

        if checkcaller() then
            return oldNC(self, ...)
        end
        local ch = LocalPlayer.Character

        if ch and compareinstances(self, ch) then
            if method == "GetAttribute" then
                local attr = ...
                if attr == "Stamina" then
                    return 100
                elseif attr == "Exhausted" then
                    return false
                end
            elseif method == "SetAttribute" then
                local attr = ...
                if attr == "Stamina" or attr == "Exhausted" then
                    return
                end
            end
        end

        if method == "FireServer" then
            if typeof(self) == "Instance" then
                local name = self.Name
                -- // Silent Melee
                if name == "combat.melee" then
                    local data = select(1, ...)
                    if type(data) == "table" then
                        local rp = getroot()
                        if rp then
                            local targetPos = getNearestToPosition(rp.Position, MELEE_RANGE)
                            if targetPos then
                                local flat = Vector3.new(targetPos.X - rp.Position.X, 0, targetPos.Z - rp.Position.Z)
                                if flat.Magnitude > 0.0501407 then
                                    local dir = flat.Unit
                                    lastMeleeYaw = math.atan2(-dir.X, -dir.Z)
                                    lastMeleeTime = os.clock()
                                    if Weapons then
                                        Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                                    end
                                    local dataCopy = table.clone(data)
                                    dataCopy.d = dir
                                    return oldNC(self, dataCopy, select(2, ...))
                                end
                            end
                        end
                    end
                -- // Silent Melee
                elseif name == "char.state" then
                    local data = select(1, ...)
                    if type(data) == "table" and rawget(data, "aimYaw") ~= nil then
                        if lastAimYaw and os.clock() - lastAimTime <= 1.0 then
                            local dataCopy = table.clone(data)
                            dataCopy.aimYaw = lastAimYaw
                            return oldNC(self, dataCopy, select(2, ...))
                        elseif lastMeleeYaw and os.clock() - lastMeleeTime <= 1.0 then
                            local dataCopy = table.clone(data)
                            dataCopy.aimYaw = lastMeleeYaw
                            return oldNC(self, dataCopy, select(2, ...))
                        end
                    end
                -- // Silent Aim
                elseif name == "combat.fire" then
                    local data = select(1, ...)
                    if type(data) == "table" then
                        local origin = rawget(data, "o") or data.o
                        if typeof(origin) ~= "Vector3" then
                            local rp = getroot()
                            origin = rp and rp.Position or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position) or Vector3.zero
                        end
                        local targetPos = getNearestToMouse(origin, GUN_RANGE)
                        if targetPos then
                            local diff = targetPos - origin
                            local dir = diff.Unit
                            local yaw = math.atan2(-dir.X, -dir.Z)
                            if Weapons then
                                Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                            end
                            local dataCopy = table.clone(data)
                            dataCopy.d = dir
                            dataCopy.a = true
                            dataCopy.sp = 0
                            dataCopy.ay = yaw
                            lastAimYaw = yaw
                            lastAimTime = os.clock()
                            return oldNC(self, dataCopy, select(2, ...))
                        end
                        if Weapons then
                            Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                        end
                        local dataCopy = table.clone(data)
                        dataCopy.sp = 0
                        dataCopy.a = true
                        return oldNC(self, dataCopy, select(2, ...))
                    end
                elseif name == "combat.throw" then
                    local data = select(1, ...)
                    if type(data) == "table" and not rawget(data, "select") then
                        local rp = getroot()
                        if rp then
                            local targetPos = getNearestToMouse(rp.Position, GUN_RANGE) or getNearestToPosition(rp.Position, MELEE_RANGE)
                            if targetPos then
                                if Weapons then
                                    Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                                end
                                local dataCopy = table.clone(data)
                                dataCopy.p = targetPos
                                return oldNC(self, dataCopy, select(2, ...))
                            end
                        end
                    end
                end
                -- // Silent Aim
            end
        end

        return oldNC(self, ...)
    end))

    local oldIndex; oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if key == "rbxbanplr" or key == "rbxBanPlr" or key == "rbxBanPlayer" or key == "_rbxPkgGuid" then
            return 0x4E4947
        end

        if checkcaller() then
            return oldIndex(self, key)
        end

        if key == "LookVector" then
            local tb = debug.traceback("", 2)
            if tb:find(("WeaponClient\u{200B}"):sub(1, 12), 1, true) and (tb:find("swing", 1, true) or tb:find("melee", 1, true)) then
                local rp = getroot()
                if rp then
                    local targetPos = getNearestToPosition(rp.Position, MELEE_RANGE)
                    if targetPos then
                        local flat = Vector3.new(targetPos.X - rp.Position.X, 0, targetPos.Z - rp.Position.Z)
                        if flat.Magnitude > 0.0501407 then
                            local yaw = math.atan2(-flat.X, -flat.Z)
                            lastMeleeYaw = yaw
                            lastMeleeTime = os.clock()
                            if Weapons then
                                Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                            end
                            return flat.Unit
                        end
                    end
                end
            end
        elseif key == "CFrame" then
            local rp = getroot()
            if rp and compareinstances(self, rp) then
                local tb = debug.traceback("", 2)
                if tb:find(("WeaponClient\u{200B}"):sub(1, 12), 1, true) and (tb:find("swing", 1, true) or tb:find("melee", 1, true)) then
                    local targetPos = getNearestToPosition(rp.Position, MELEE_RANGE)
                    if targetPos then
                        local flat = Vector3.new(targetPos.X - rp.Position.X, 0, targetPos.Z - rp.Position.Z)
                        if flat.Magnitude > 0.0501407 then
                            local yaw = math.atan2(-flat.X, -flat.Z)
                            lastMeleeYaw = yaw
                            lastMeleeTime = os.clock()
                            if Weapons then
                                Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                            end
                            return CFrame.lookAt(rp.Position, rp.Position + flat)
                        end
                    end
                end
            end
        end

        return oldIndex(self, key)
    end))

    local oldNewIndex; oldNewIndex = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
        if checkcaller() then
            return oldNewIndex(self, key, value)
        end

        local ch = LocalPlayer.Character
        if ch and compareinstances(self, ch) and (key == "Stamina" or key == "Exhausted") then
            return
        end

        return oldNewIndex(self, key, value)
    end))

