    if Controllers then
        local WeaponClientModule = Controllers:FindFirstChild("WeaponClient")
        if WeaponClientModule then
            local WeaponClient = require(WeaponClientModule)
            if type(WeaponClient) == "table" and type(WeaponClient.step) == "function" then
                local stepUpvals = debug.getupvalues(WeaponClient.step)
                local cctx
                for idx, val in next, stepUpvals do
                    if type(val) == "table" and (rawget(val, "net") or rawget(val, "controllers")) then
                        cctx = val
                        break
                    end
                end
                if cctx and type(rawget(cctx, "net")) == "table" then
                    local net = rawget(cctx, "net")
                    if type(net.fire) == "function" then
                        local oldNetFire; oldNetFire = hookfunction(net.fire, newcclosure(function(name, data, ...)
                            if name == "combat.melee" and type(data) == "table" then
                                local rp = getroot()
                                if rp then
                                    local targetPos = getNearestToPosition(rp.Position, MELEE_RANGE)
                                    if targetPos then
                                        local flat = Vector3.new(targetPos.X - rp.Position.X, 0, targetPos.Z - rp.Position.Z)
                                        if flat.Magnitude > 0.0501407 then
                                            local dir = flat.Unit
                                            lastMeleeYaw = math.atan2(-dir.X, -dir.Z)
                                            lastMeleeTime = os.clock()
                                            if Weapons then
                                                Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                                            end
                                            data.d = dir
                                        end
                                    end
                                end
                            elseif name == "char.state" and type(data) == "table" and rawget(data, "aimYaw") ~= nil then
                                if lastAimYaw and os.clock() - lastAimTime <= 1.0 then
                                    data.aimYaw = lastAimYaw
                                elseif lastMeleeYaw and os.clock() - lastMeleeTime <= 1.0 then
                                    data.aimYaw = lastMeleeYaw
                                end
                            elseif name == "combat.fire" and type(data) == "table" then
                                local origin = rawget(data, "o") or data.o
                                if typeof(origin) ~= "Vector3" then
                                    local rp = getroot()
                                    origin = rp and rp.Position or (Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame.Position) or Vector3.zero
                                end
                                local targetPos = getNearestToMouse(origin, GUN_RANGE)
                                if targetPos then
                                    local diff = targetPos - origin
                                    if diff.Magnitude > 0.0501407 then
                                        local dir = diff.Unit
                                        if Weapons then
                                            Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                                        end
                                        data.d = dir
                                        data.a = true
                                        data.sp = 0
                                        data.ay = math.atan2(-dir.X, -dir.Z)
                                    end
                                else
                                    if Weapons then
                                        Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                                    end
                                    data.a = true
                                    data.sp = 0
                                end
                            elseif name == "combat.throw" and type(data) == "table" and not rawget(data, "select") then
                                local rp = getroot()
                                if rp then
                                    local targetPos = getNearestToMouse(rp.Position, GUN_RANGE) or getNearestToPosition(rp.Position, MELEE_RANGE)
                                    if targetPos then
                                        if Weapons then
                                            Weapons._netSeq = (Weapons._netSeq or 0x4E4947) + 1
                                        end
                                        data.p = targetPos
                                    end
                                end
                            end
                            return oldNetFire(name, data, ...)
                        end))
                    end
                end
            end
        end
    end

